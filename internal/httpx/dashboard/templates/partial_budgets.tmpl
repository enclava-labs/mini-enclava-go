{{define "partial-budgets"}}
<div class="space-y-4">
  {{if not .Rows}}
  <div class="py-16 text-center">
    <h3 class="text-lg font-semibold">No active budgets</h3>
    <p class="text-sm text-muted-foreground mt-1">No allowance is configured for this billing subject.</p>
  </div>
  {{else}}
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    {{range .Rows}}
    <section class="rounded-lg border bg-card text-card-foreground shadow-sm">
      <h2 class="px-5 py-4 border-b font-semibold">{{.Subject}}</h2>
      <div class="px-5 py-4 space-y-2 text-sm">
        <p>Window: <span class="font-semibold">{{.Window}}</span></p>
        <p>Limit: <span class="font-semibold">{{.Limit}}</span></p>
        <p>Held: {{.Held}}</p>
        <p>Unknown: {{.Unknown}}</p>
        <p>Settled: {{.Settled}}</p>
        <p>Remaining allowance: <span class="font-semibold">{{.Remaining}}</span></p>
      </div>
    </section>
    {{end}}
  </div>
  {{end}}
</div>
{{end}}
