{{define "partial-budgets"}}
<div class="space-y-4">
  <div class="flex flex-wrap items-center gap-4 text-sm">
    <p class="text-muted-foreground">Accounted liability: <span class="font-semibold text-foreground">{{.TotalUsed}}</span></p>
    <p class="text-muted-foreground">Tenant default limit: <span class="font-semibold text-foreground">{{.TotalLimit}}</span></p>
  </div>

  {{if not .Rows}}
  {{/* Empty state */}}
  <div class="py-16 text-center">
    <h3 class="text-lg font-semibold">No liability recorded for this billing subject</h3>
    <p class="text-sm text-muted-foreground mt-1">Limit details are unavailable in this view.</p>
  </div>
  {{else}}
  {{/* Card grid */}}
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    {{range .Rows}}
    <div class="rounded-lg border bg-card text-card-foreground shadow-sm flex flex-col">
      <div class="px-5 py-4 border-b">
        <span class="font-semibold truncate">Billing subject</span>
      </div>
      <div class="px-5 py-4 space-y-2 text-sm">
        <p>Usage liability: <span class="font-semibold">{{.UsedDisplay}}</span></p>
        <p>Enforced limit: {{.BudgetLimit}} ({{.BudgetPeriod}})</p>
        <p>Remaining allowance: {{.Remaining}}</p>
        <p>Reserved units: {{.Units}}</p>
        <p class="text-muted-foreground">{{.Status}}</p>
      </div>
    </div>
    {{end}}
  </div>
  {{end}}
</div>
{{end}}
