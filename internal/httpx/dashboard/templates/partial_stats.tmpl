{{define "partial-stats"}}
<section id="dashboard-stats" class="space-y-6">

  <!-- Signature: live attestation seal. State is set by dashboard.js
       from /health (sealed / unsealed / off / checking). -->
  <div id="seal-band" class="seal-band reveal reveal-1" data-state="checking">
    <span class="seal-dot" aria-hidden="true"></span>
    <div class="seal-copy">
      <div id="seal-title" class="seal-title">Verifying enclave</div>
      <div id="seal-meta" class="seal-meta">Contacting the attestation service&hellip;</div>
    </div>
    <a href="/api/v1/attestation/status" class="seal-action">Attestation</a>
  </div>

  <!-- Instrument strip: one ribbon, hairline dividers, mono numerals. -->
  <div class="stat-ribbon reveal reveal-2">
    <div class="stat">
      <div class="eyebrow">Active keys</div>
      <div class="stat-value">{{.ActiveAPIKeys}}</div>
    </div>
    <div class="stat">
      <div class="eyebrow">Extract · 24h</div>
      <div class="stat-value">{{.RecentExtractJobs}}</div>
    </div>
    <div class="stat">
      <div class="eyebrow">Extract · total</div>
      <div class="stat-value">{{.TotalExtractJobs}}</div>
    </div>
    <div class="stat">
      <div class="eyebrow">Budget used</div>
      <div class="stat-value">{{.BudgetPercent}}<span style="font-size:0.95rem;color:hsl(var(--muted-foreground));margin-left:0.1rem">%</span></div>
      <div class="stat-sub">{{.BudgetUsed}} / {{.BudgetTotal}}</div>
      <div class="stat-meter{{if ge .BudgetPercent 80}} warn{{end}}"><span style="width:{{.BudgetPercent}}%"></span></div>
    </div>
  </div>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
    <div class="surface surface-pad reveal reveal-3">
      <h3 class="surface-title">System snapshot</h3>
      <div class="mt-5 space-y-4">
        <div class="flex items-center justify-between gap-4">
          <div>
            <p class="font-medium">Provider</p>
            <p class="text-sm text-muted-foreground mt-0.5">
              <span id="provider-dot" class="status-dot"></span><span id="system-status">Checking provider&hellip;</span>
            </p>
          </div>
        </div>
        <hr class="rule">
        <div class="flex items-center justify-between gap-4">
          <div>
            <p class="font-medium">Extract module</p>
            <p class="text-sm text-muted-foreground mt-0.5"><span class="status-dot ok"></span>Enabled</p>
          </div>
          <a href="/dashboard/extract" class="inline-flex items-center justify-center rounded-md text-sm font-medium h-9 px-4 border border-input bg-background hover:bg-accent hover:text-accent-foreground transition-colors">
            Open
          </a>
        </div>
        <hr class="rule">
        <div>
          <p class="font-medium">Attestation</p>
          <p class="text-sm text-muted-foreground mt-0.5">
            <span id="attest-dot" class="status-dot"></span><span id="provider-status">Checking attestation&hellip;</span>
          </p>
        </div>
      </div>
    </div>

    <div class="surface surface-pad reveal reveal-4">
      <h3 class="surface-title">API access</h3>
      <p class="text-sm text-muted-foreground mt-1">Base URL for clients and SDKs.</p>
      <div class="mt-5 space-y-3">
        <div class="eyebrow">Endpoint</div>
        <div class="endpoint-plate">
          <code id="api-endpoint" class="min-w-0 flex-1 truncate text-muted-foreground"></code>
          <button id="copy-api-endpoint" type="button" class="shrink-0 p-1.5 rounded hover:bg-accent" title="Copy endpoint">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/>
            </svg>
          </button>
        </div>
        <div class="flex items-center gap-3 text-sm pt-1">
          <a href="/dashboard/keys" class="text-primary hover:underline">Manage keys</a>
          <span class="text-muted-foreground opacity-40">·</span>
          <a href="/dashboard/budgets" class="text-primary hover:underline">Budgets</a>
          <span class="text-muted-foreground opacity-40">·</span>
          <a href="/api/v1/models" class="text-primary hover:underline">List models</a>
        </div>
      </div>
    </div>
  </div>
</section>
{{end}}
