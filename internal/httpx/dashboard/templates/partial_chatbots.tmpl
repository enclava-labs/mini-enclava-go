{{define "partial-chatbots"}}
<div class="space-y-6">
{{if .Success}}<div class="rounded-md border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800 dark:border-green-900/40 dark:bg-green-950/30 dark:text-green-200">{{.Success}}</div>{{end}}
{{if .Error}}<div class="rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800 dark:border-red-900/40 dark:bg-red-950/30 dark:text-red-200">{{.Error}}</div>{{end}}

<div class="rounded-lg border bg-card p-5">
  <form class="grid gap-4 md:grid-cols-6" hx-post="/dashboard/partials/chatbots" hx-target="#dashboard-chatbots" hx-swap="innerHTML">
    <input type="hidden" name="action" value="create_chatbot">
    <label class="space-y-1 text-sm font-medium">
      <span>Name</span>
      <input class="w-full rounded-md border bg-background px-3 py-2 text-sm font-normal" name="name" required>
    </label>
    <label class="space-y-1 text-sm font-medium">
      <span>Model</span>
      <input class="w-full rounded-md border bg-background px-3 py-2 text-sm font-normal" name="model" required>
    </label>
    <label class="space-y-1 text-sm font-medium">
      <span>Prompt template</span>
      <select class="w-full rounded-md border bg-background px-3 py-2 text-sm font-normal" name="prompt_template_id">
        <option value="">Use service default</option>
        {{range .PromptTemplates}}<option value="{{.ID}}">{{.Name}}</option>{{end}}
      </select>
    </label>
    <label class="space-y-1 text-sm font-medium">
      <span>RAG collection</span>
      <select class="w-full rounded-md border bg-background px-3 py-2 text-sm font-normal" name="rag_collection_id">
        <option value="">Do not attach collection</option>
        {{range .Collections}}<option value="{{.ID}}">{{.Name}}</option>{{end}}
      </select>
    </label>
    <label class="space-y-1 text-sm font-medium">
      <span>External ID</span>
      <input class="w-full rounded-md border bg-background px-3 py-2 text-sm font-normal" name="external_id">
    </label>
    <button class="inline-flex h-10 items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground" type="submit">Create</button>
  </form>
</div>

<div class="rounded-lg border bg-card overflow-hidden">
  <div class="border-b px-5 py-4">
    <h3 class="font-semibold">Chatbot Instances</h3>
  </div>
  {{if not .Chatbots}}
  <div class="p-8 text-center text-sm text-muted-foreground">No chatbots configured.</div>
  {{else}}
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="bg-muted/50 text-muted-foreground">
        <tr>
          <th class="px-4 py-3 text-left font-medium">Name</th>
          <th class="px-4 py-3 text-left font-medium">External Endpoint</th>
          <th class="px-4 py-3 text-left font-medium">Model</th>
          <th class="px-4 py-3 text-left font-medium">RAG Collections</th>
          <th class="px-4 py-3 text-left font-medium">Status</th>
          <th class="px-4 py-3 text-left font-medium">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y">
        {{range .Chatbots}}
        <tr>
          <td class="px-4 py-3">
            <p class="font-medium">{{.Name}}</p>
            <p class="text-xs text-muted-foreground font-mono">{{.ID}}</p>
          </td>
          <td class="px-4 py-3 font-mono">/api/v1/chatbot/external/{{.ExternalID}}/chat/completions</td>
          <td class="px-4 py-3 font-mono">{{.Model}}</td>
          <td class="px-4 py-3">{{len .RAGCollectionIDs}}</td>
          <td class="px-4 py-3">{{if .IsEnabled}}Enabled{{else}}Disabled{{end}}</td>
          <td class="px-4 py-3">
            <div class="flex flex-wrap gap-2">
              <form hx-post="/dashboard/partials/chatbots" hx-target="#dashboard-chatbots" hx-swap="innerHTML">
                <input type="hidden" name="action" value="set_enabled">
                <input type="hidden" name="chatbot_id" value="{{.ID}}">
                {{if .IsEnabled}}<input type="hidden" name="enabled" value="false"><button class="inline-flex h-8 items-center justify-center rounded-md border px-3 text-xs font-medium" type="submit">Disable</button>{{else}}<input type="hidden" name="enabled" value="true"><button class="inline-flex h-8 items-center justify-center rounded-md border px-3 text-xs font-medium" type="submit">Enable</button>{{end}}
              </form>
              <form hx-post="/dashboard/partials/chatbots" hx-target="#dashboard-chatbots" hx-swap="innerHTML" hx-confirm="Delete this chatbot?">
                <input type="hidden" name="action" value="delete_chatbot">
                <input type="hidden" name="chatbot_id" value="{{.ID}}">
                <button class="inline-flex h-8 items-center justify-center rounded-md border border-red-200 px-3 text-xs font-medium text-red-700 hover:bg-red-50 dark:border-red-900/40 dark:text-red-300 dark:hover:bg-red-950/20" type="submit">Delete</button>
              </form>
            </div>
          </td>
        </tr>
        {{end}}
      </tbody>
    </table>
  </div>
  {{end}}
</div>
</div>
{{end}}
