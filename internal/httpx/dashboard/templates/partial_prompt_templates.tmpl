{{define "partial-prompt-templates"}}
<div class="space-y-6">
{{if .Success}}<div class="rounded-md border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800 dark:border-green-900/40 dark:bg-green-950/30 dark:text-green-200">{{.Success}}</div>{{end}}
{{if .Error}}<div class="rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800 dark:border-red-900/40 dark:bg-red-950/30 dark:text-red-200">{{.Error}}</div>{{end}}

<div class="rounded-lg border bg-card p-5">
  <form class="grid gap-4 md:grid-cols-2" hx-post="/dashboard/partials/prompt-templates" hx-target="#dashboard-prompt-templates" hx-swap="innerHTML">
    <label class="space-y-1 text-sm font-medium">
      <span>Name</span>
      <input class="w-full rounded-md border bg-background px-3 py-2 text-sm font-normal" name="name" required>
    </label>
    <label class="space-y-1 text-sm font-medium">
      <span>ID</span>
      <input class="w-full rounded-md border bg-background px-3 py-2 text-sm font-normal" name="id">
    </label>
    <label class="space-y-1 text-sm font-medium md:col-span-2">
      <span>System prompt</span>
      <textarea class="min-h-24 w-full rounded-md border bg-background px-3 py-2 text-sm font-normal" name="system_prompt"></textarea>
    </label>
    <label class="space-y-1 text-sm font-medium md:col-span-2">
      <span>User prompt</span>
      <textarea class="min-h-24 w-full rounded-md border bg-background px-3 py-2 text-sm font-normal" name="user_prompt"></textarea>
    </label>
    <label class="space-y-1 text-sm font-medium">
      <span>Variables schema JSON</span>
      <textarea class="min-h-20 w-full rounded-md border bg-background px-3 py-2 text-sm font-normal" name="variables_schema"></textarea>
    </label>
    <label class="inline-flex items-center gap-2 text-sm"><input type="checkbox" name="is_default" class="h-4 w-4"> Default</label>
    <div class="md:col-span-2 flex justify-end">
      <button class="inline-flex h-10 items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground" type="submit">Create</button>
    </div>
  </form>
</div>

<div class="rounded-lg border bg-card overflow-hidden">
  <div class="border-b px-5 py-4">
    <h3 class="font-semibold">Prompt Templates</h3>
  </div>
  {{if not .Templates}}
  <div class="p-8 text-center text-sm text-muted-foreground">No prompt templates.</div>
  {{else}}
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="bg-muted/50 text-muted-foreground">
        <tr>
          <th class="px-4 py-3 text-left font-medium">Name</th>
          <th class="px-4 py-3 text-left font-medium">System Prompt</th>
          <th class="px-4 py-3 text-left font-medium">User Prompt</th>
          <th class="px-4 py-3 text-left font-medium">Flags</th>
        </tr>
      </thead>
      <tbody class="divide-y">
        {{range .Templates}}
        <tr>
          <td class="px-4 py-3">
            <p class="font-medium">{{.Name}}</p>
            <p class="text-xs text-muted-foreground font-mono">{{.ID}}</p>
          </td>
          <td class="px-4 py-3 max-w-sm truncate">{{.SystemPrompt}}</td>
          <td class="px-4 py-3 max-w-sm truncate">{{.UserPrompt}}</td>
          <td class="px-4 py-3">
            {{if .IsDefault}}<span class="mr-2 rounded-full bg-primary/10 px-2 py-0.5 text-xs text-primary">Default</span>{{end}}
            {{if .IsActive}}<span class="rounded-full bg-green-100 px-2 py-0.5 text-xs text-green-700 dark:bg-green-900/20 dark:text-green-300">Active</span>{{else}}<span class="rounded-full bg-muted px-2 py-0.5 text-xs text-muted-foreground">Inactive</span>{{end}}
          </td>
        </tr>
        {{end}}
      </tbody>
    </table>
  </div>
  {{end}}
</div>
</div>
{{end}}
