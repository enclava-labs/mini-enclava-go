{{define "partial-providers"}}
<div class="space-y-6">
  <div class="grid gap-4 md:grid-cols-3">
    <div class="rounded-lg border bg-card p-5">
      <p class="text-sm text-muted-foreground">Provider readiness</p>
      <p class="mt-2 text-2xl font-semibold">{{if .Snapshot.Ready}}Ready{{else}}Not Ready{{end}}</p>
      <p class="mt-1 text-xs text-muted-foreground">Failures: {{.Snapshot.ConsecutiveFailures}}</p>
    </div>
    <div class="rounded-lg border bg-card p-5">
      <p class="text-sm text-muted-foreground">Models</p>
      <p class="mt-2 text-2xl font-semibold">{{len .Models}}</p>
      <p class="mt-1 text-xs text-muted-foreground">Available through the configured provider</p>
    </div>
    <div class="rounded-lg border bg-card p-5">
      <p class="text-sm text-muted-foreground">Attestation</p>
      {{with .Attestation}}
      <p class="mt-2 text-2xl font-semibold">{{if .Verified}}Verified{{else}}Unverified{{end}}</p>
      <p class="mt-1 text-xs text-muted-foreground">{{.Provider}}</p>
      {{else}}
      <p class="mt-2 text-2xl font-semibold">Unavailable</p>
      <p class="mt-1 text-xs text-muted-foreground">Provider does not expose attestation</p>
      {{end}}
    </div>
  </div>

  {{if .Error}}
  <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700 dark:border-red-900/40 dark:bg-red-950/20 dark:text-red-300">{{.Error}}</div>
  {{end}}

  <div class="rounded-lg border bg-card overflow-hidden">
    <div class="border-b px-5 py-4">
      <h3 class="font-semibold">Provider Models</h3>
    </div>
    {{if not .Models}}
    <div class="p-8 text-center text-sm text-muted-foreground">No models returned by the configured provider.</div>
    {{else}}
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-muted/50 text-muted-foreground">
          <tr>
            <th class="px-4 py-3 text-left font-medium">Model</th>
            <th class="px-4 py-3 text-left font-medium">Owned By</th>
            <th class="px-4 py-3 text-left font-medium">Tasks</th>
          </tr>
        </thead>
        <tbody class="divide-y">
          {{range .Models}}
          <tr>
            <td class="px-4 py-3 font-mono">{{.ID}}</td>
            <td class="px-4 py-3">{{.OwnedBy}}</td>
            <td class="px-4 py-3">{{range .Tasks}}<span class="mr-2">{{.}}</span>{{end}}</td>
          </tr>
          {{end}}
        </tbody>
      </table>
    </div>
    {{end}}
  </div>
</div>
{{end}}
