{{define "partial-usage"}}
<div class="space-y-6">
  <!-- Stat cards row -->
  <div class="grid gap-4 sm:grid-cols-3">
    <!-- Total Requests -->
    <div class="rounded-lg border bg-card text-card-foreground shadow-sm p-5">
      <div class="flex items-center justify-between">
        <div>
          <p class="text-sm font-medium text-muted-foreground">Total Requests</p>
          <p class="text-2xl font-bold mt-1">{{.TotalRequests}}</p>
        </div>
        <div class="p-3 rounded-full bg-blue-500/10 text-blue-500">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
          </svg>
        </div>
      </div>
    </div>
    <div class="rounded-lg border bg-card text-card-foreground shadow-sm p-5">
      <p class="text-sm font-medium text-muted-foreground">Raw settled usage ({{.Days}} days)</p>
      <p class="text-2xl font-bold mt-1">{{.TotalTokens}} units</p>
    </div>
    <div class="rounded-lg border bg-card text-card-foreground shadow-sm p-5">
      <p class="text-sm font-medium text-muted-foreground">Settled cost ({{.Days}} days)</p>
      {{range .CurrencyTotals}}
      <p class="text-2xl font-bold mt-1">{{.Currency}} {{formatCurrencyMicros .Currency .AmountMicros}}</p>
      {{else}}
      <p class="text-2xl font-bold mt-1">No settled cost</p>
      {{end}}
      <p class="text-xs text-muted-foreground mt-2">Settled usage only; see Budgets for held and unknown liability.</p>
    </div>
  </div>
  <section class="rounded-lg border bg-card text-card-foreground shadow-sm">
    <div class="p-5 pb-3 border-b"><h4 class="text-sm font-semibold">Usage by billing subject and currency</h4></div>
    <div class="p-5 pt-3 space-y-3">
      {{range .BySubject}}
      <div class="flex items-center justify-between text-sm">
        <span>{{.SubjectType}} <span class="font-mono">{{.SubjectID}}</span></span>
        <span>{{.Currency}} {{formatCurrencyMicros .Currency .AmountMicros}} · {{.RequestCount}} requests · {{.TotalUnits}} raw units</span>
      </div>
      {{else}}<p class="text-sm text-muted-foreground">No settled usage by subject.</p>{{end}}
    </div>
  </section>

  <!-- Two-column grid: Endpoint + Model breakdowns -->
  <div class="grid gap-4 md:grid-cols-2">
    <!-- Usage by Endpoint -->
    <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
      <div class="p-5 pb-3 border-b">
        <h4 class="text-sm font-semibold">Usage by Endpoint</h4>
      </div>
      <div class="p-5 pt-3">
        {{if .ByEndpoint}}
        <div class="space-y-3">
          {{range .ByEndpoint}}
          <div class="flex items-center justify-between text-sm">
            <span class="font-mono text-xs truncate mr-3">{{.Key}}</span>
            <div class="flex items-center gap-3 shrink-0">
              <span class="text-muted-foreground">{{.RequestCount}} req</span>
              <span class="text-muted-foreground">&middot;</span>
              <span class="text-muted-foreground">{{.TotalUnits}} raw units</span>
              <span class="text-muted-foreground">&middot;</span>
              <span class="text-muted-foreground">{{.Currency}} {{formatCurrencyMicros .Currency .AmountMicros}}</span>
            </div>
          </div>
          {{end}}
        </div>
        {{else}}
        <p class="text-sm text-muted-foreground text-center py-4">No endpoint data available.</p>
        {{end}}
      </div>
    </div>
    <!-- Usage by Model -->
    <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
      <div class="p-5 pb-3 border-b">
        <h4 class="text-sm font-semibold">Usage by Model</h4>
      </div>
      <div class="p-5 pt-3">
        {{if .ByModel}}
        <div class="space-y-3">
          {{range .ByModel}}
          <div class="flex items-center justify-between text-sm">
            <span class="font-mono text-xs truncate mr-3">{{.Key}}</span>
            <div class="flex items-center gap-3 shrink-0">
              <span class="text-muted-foreground">{{.RequestCount}} req</span>
              <span class="text-muted-foreground">&middot;</span>
              <span class="text-muted-foreground">{{.TotalUnits}} raw units</span>
              <span class="text-muted-foreground">&middot;</span>
              <span class="text-muted-foreground">{{.Currency}} {{formatCurrencyMicros .Currency .AmountMicros}}</span>
            </div>
          </div>
          {{end}}
        </div>
        {{else}}
        <p class="text-sm text-muted-foreground text-center py-4">No model data available.</p>
        {{end}}
      </div>
    </div>
  </div>

  <!-- Per-key breakdown table -->
  <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
    <div class="p-5 pb-3 border-b">
      <h4 class="text-sm font-semibold">Settled usage by API key</h4>
    </div>
    <div class="rounded-md overflow-hidden">
      <table class="w-full caption-bottom text-sm">
        <thead class="[&_tr]:border-b bg-muted/50">
          <tr class="border-b transition-colors">
            <th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground text-xs">API key</th>
            <th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground text-xs">Settled requests</th>
            <th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground text-xs">Raw units</th>
            <th class="h-10 px-4 text-left align-middle font-medium text-muted-foreground text-xs">Settled cost</th>
          </tr>
        </thead>
        <tbody class="[&_tr:last-child]:border-0">
          {{range .Rows}}
          <tr class="border-b transition-colors hover:bg-muted/50">
            <td class="p-4 align-middle">{{.APIKeyName}}</td>
            <td class="p-4 align-middle">{{.RequestCount}}</td>
            <td class="p-4 align-middle">{{.TotalTokens}}</td>
            <td class="p-4 align-middle">{{.CostDisplay}}</td>
          </tr>
          {{else}}
          <tr>
            <td colspan="4" class="p-8 text-center text-muted-foreground">No settled usage attributed to API keys in this window.</td>
          </tr>
          {{end}}
        </tbody>
      </table>
    </div>
  </div>
</div>
{{end}}
