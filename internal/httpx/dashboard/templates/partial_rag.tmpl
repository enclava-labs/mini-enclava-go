{{define "partial-rag"}}
<div class="space-y-6">
{{if .Success}}<div class="rounded-md border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-800 dark:border-green-900/40 dark:bg-green-950/30 dark:text-green-200">{{.Success}}</div>{{end}}
{{if .Error}}<div class="rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800 dark:border-red-900/40 dark:bg-red-950/30 dark:text-red-200">{{.Error}}</div>{{end}}

<div class="rounded-lg border bg-card p-5">
  <form class="grid gap-4 md:grid-cols-5" hx-post="/dashboard/partials/rag" hx-target="#dashboard-rag" hx-swap="innerHTML">
    <input type="hidden" name="action" value="create_collection">
    <label class="space-y-1 text-sm font-medium">
      <span>Collection name</span>
      <input class="w-full rounded-md border bg-background px-3 py-2 text-sm font-normal" name="name" required>
    </label>
    <label class="space-y-1 text-sm font-medium">
      <span>Embedding model</span>
      <input class="w-full rounded-md border bg-background px-3 py-2 text-sm font-normal" name="embedding_model">
    </label>
    <label class="space-y-1 text-sm font-medium">
      <span>Chunk size</span>
      <input class="w-full rounded-md border bg-background px-3 py-2 text-sm font-normal" name="chunk_size" value="1000">
    </label>
    <label class="inline-flex items-center gap-2 text-sm"><input type="checkbox" name="public" class="h-4 w-4"> Public</label>
    <button class="inline-flex h-10 items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground" type="submit">Create</button>
  </form>
</div>

{{if .Collections}}
<div class="rounded-lg border bg-card p-5">
  <form class="grid gap-4 md:grid-cols-4" hx-post="/dashboard/partials/rag" hx-target="#dashboard-rag" hx-swap="innerHTML" enctype="multipart/form-data">
    <input type="hidden" name="action" value="upload_document">
    <select class="rounded-md border bg-background px-3 py-2 text-sm" name="collection_id" required>
      {{range .Collections}}<option value="{{.ID}}">{{.Name}}</option>{{end}}
    </select>
    <input class="rounded-md border bg-background px-3 py-2 text-sm" type="file" name="file" required>
    <div></div>
    <button class="inline-flex h-10 items-center justify-center rounded-md border px-4 text-sm font-medium" type="submit">Upload</button>
  </form>
</div>
{{end}}

<div class="rounded-lg border bg-card overflow-hidden">
  <div class="border-b px-5 py-4">
    <h3 class="font-semibold">RAG Collections</h3>
  </div>
  {{if not .Collections}}
  <div class="p-8 text-center text-sm text-muted-foreground">No RAG collections.</div>
  {{else}}
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="bg-muted/50 text-muted-foreground">
        <tr>
          <th class="px-4 py-3 text-left font-medium">Name</th>
          <th class="px-4 py-3 text-left font-medium">Embedding Model</th>
          <th class="px-4 py-3 text-left font-medium">Chunking</th>
          <th class="px-4 py-3 text-left font-medium">Qdrant</th>
          <th class="px-4 py-3 text-left font-medium">Status</th>
          <th class="px-4 py-3 text-left font-medium">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y">
        {{range .Collections}}
        <tr>
          <td class="px-4 py-3">
            <p class="font-medium">{{.Name}}</p>
            <p class="text-xs text-muted-foreground font-mono">{{.ID}}</p>
          </td>
          <td class="px-4 py-3 font-mono">{{.EmbeddingModel}}</td>
          <td class="px-4 py-3">{{.ChunkSize}} / {{.ChunkOverlap}}</td>
          <td class="px-4 py-3 font-mono">{{.QdrantCollection}}</td>
          <td class="px-4 py-3">{{if .IsActive}}Active{{else}}Inactive{{end}}</td>
          <td class="px-4 py-3">
            <form hx-post="/dashboard/partials/rag" hx-target="#dashboard-rag" hx-swap="innerHTML" hx-confirm="Delete this collection and its documents?">
              <input type="hidden" name="action" value="delete_collection">
              <input type="hidden" name="collection_id" value="{{.ID}}">
              <button class="inline-flex h-8 items-center justify-center rounded-md border border-red-200 px-3 text-xs font-medium text-red-700 hover:bg-red-50 dark:border-red-900/40 dark:text-red-300 dark:hover:bg-red-950/20" type="submit">Delete</button>
            </form>
          </td>
        </tr>
        {{end}}
      </tbody>
    </table>
  </div>
  {{end}}
</div>

<div class="rounded-lg border bg-card overflow-hidden">
  <div class="border-b px-5 py-4">
    <h3 class="font-semibold">RAG Documents</h3>
  </div>
  {{if not .Documents}}
  <div class="p-8 text-center text-sm text-muted-foreground">No RAG documents.</div>
  {{else}}
  <div class="overflow-x-auto">
    <table class="w-full text-sm">
      <thead class="bg-muted/50 text-muted-foreground">
        <tr>
          <th class="px-4 py-3 text-left font-medium">File</th>
          <th class="px-4 py-3 text-left font-medium">Collection</th>
          <th class="px-4 py-3 text-left font-medium">Status</th>
          <th class="px-4 py-3 text-left font-medium">Points</th>
          <th class="px-4 py-3 text-left font-medium">Source</th>
          <th class="px-4 py-3 text-left font-medium">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y">
        {{range .Documents}}
        <tr>
          <td class="px-4 py-3">
            <p class="font-medium">{{.FileName}}</p>
            <p class="text-xs text-muted-foreground font-mono">{{.ID}}</p>
          </td>
          <td class="px-4 py-3 font-mono">{{.CollectionID}}</td>
          <td class="px-4 py-3">{{.Status}}</td>
          <td class="px-4 py-3">{{.QdrantPointCount}}</td>
          <td class="px-4 py-3">{{if .SourceType}}{{.SourceType}}{{else}}upload{{end}}</td>
          <td class="px-4 py-3">
            <div class="flex flex-wrap gap-2">
              <a class="inline-flex h-8 items-center justify-center rounded-md border px-3 text-xs font-medium" href="/dashboard/rag/documents/{{.ID}}/download">Download</a>
              <form hx-post="/dashboard/partials/rag" hx-target="#dashboard-rag" hx-swap="innerHTML">
                <input type="hidden" name="action" value="reprocess_document">
                <input type="hidden" name="document_id" value="{{.ID}}">
                <button class="inline-flex h-8 items-center justify-center rounded-md border px-3 text-xs font-medium" type="submit">Reprocess</button>
              </form>
              <form hx-post="/dashboard/partials/rag" hx-target="#dashboard-rag" hx-swap="innerHTML" hx-confirm="Delete this document?">
                <input type="hidden" name="action" value="delete_document">
                <input type="hidden" name="document_id" value="{{.ID}}">
                <button class="inline-flex h-8 items-center justify-center rounded-md border border-red-200 px-3 text-xs font-medium text-red-700 hover:bg-red-50 dark:border-red-900/40 dark:text-red-300 dark:hover:bg-red-950/20" type="submit">Delete</button>
              </form>
            </div>
          </td>
        </tr>
        {{end}}
      </tbody>
    </table>
  </div>
  {{end}}
</div>
</div>
{{end}}
